{
  "manifest_version": 3,
  "name": "Harris Teeter Clip All",
  "version": "1.0.0",
  "description": "Adds a single button that clips every e-VIC coupon to your account.",
  "content_scripts": [
    {
      "matches": ["https://www.harristeeter.com/*"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "harristeeter-clip-all@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
